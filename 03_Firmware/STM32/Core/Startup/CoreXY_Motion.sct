; *************************************************************
; *** Scatter-Loading Description File generated by hand      ***
; *** STM32F407ZET6: FLASH 512K@0x08000000, RAM 128K@0x20000000 ***
; *** CCM 64K@0x10000000（可选项，未使用）                       ***
; *************************************************************

LR_IROM1 0x08000000 0x00080000  {    ; load region size_1 = 512KB
  ER_IROM1 0x08000000 0x00080000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; RW data = 128KB @ 0x20000000
   .ANY (+RW +ZI)
  }
}
